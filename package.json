{
  "name": "tree-sitter-htmldjango",
  "version": "0.2.1",
  "description": "HTML + Django template grammar for tree-sitter",
  "repository": "https://github.com/octoenergy/tree-sitter-htmldjango",
  "license": "MIT",
  "author": {
    "name": "octoenergy"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "html",
    "django",
    "template"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "devDependencies": {
    "eslint": "9.39.2",
    "eslint-config-treesitter": "1.0.2",
    "tree-sitter-cli": "0.26.3"
  },
  "scripts": {
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground"
  }
}
