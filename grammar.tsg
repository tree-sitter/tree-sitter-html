// HTML grammar for tree-sitter (native DSL).
// Translated from grammar.js.

grammar {
    language: "html",
    extras: [comment, regexp(r"\s+")],
    externals: [
        _start_tag_name,
        _script_start_tag_name,
        _style_start_tag_name,
        _end_tag_name,
        erroneous_end_tag_name,
        "/>",
        _implicit_end_tag,
        raw_text,
        comment,
    ],
}

rule document { repeat(_node) }

rule doctype {
    seq("<!", alias(_doctype, "doctype"), regexp(r"[^>]+"), ">")
}

rule _doctype { regexp(r"[Dd][Oo][Cc][Tt][Yy][Pp][Ee]") }

rule _node {
    choice(doctype, entity, text, element, script_element, style_element, erroneous_end_tag)
}

rule element {
    choice(
        seq(start_tag, repeat(_node), choice(end_tag, _implicit_end_tag)),
        self_closing_tag,
    )
}

rule script_element {
    seq(alias(script_start_tag, start_tag), optional(raw_text), end_tag)
}

rule style_element {
    seq(alias(style_start_tag, start_tag), optional(raw_text), end_tag)
}

rule start_tag {
    seq("<", alias(_start_tag_name, tag_name), repeat(attribute), ">")
}

rule script_start_tag {
    seq("<", alias(_script_start_tag_name, tag_name), repeat(attribute), ">")
}

rule style_start_tag {
    seq("<", alias(_style_start_tag_name, tag_name), repeat(attribute), ">")
}

rule self_closing_tag {
    seq("<", alias(_start_tag_name, tag_name), repeat(attribute), "/>")
}

rule end_tag { seq("</", alias(_end_tag_name, tag_name), ">") }

rule erroneous_end_tag { seq("</", erroneous_end_tag_name, ">") }

rule attribute {
    seq(
        attribute_name,
        optional(seq("=", choice(attribute_value, quoted_attribute_value))),
    )
}

rule attribute_name { regexp(r#"[^<>"'/=\s]+"#) }

rule attribute_value { regexp(r#"[^<>"'=\s]+"#) }

// An entity can be named, numeric (decimal), or numeric (hexadecimal). The
// longest entity name is 29 characters; the HTML spec says no more will ever
// be added.
rule entity {
    regexp(r"&(#([xX][0-9a-fA-F]{1,6}|[0-9]{1,5})|[A-Za-z]{1,30});?")
}

rule quoted_attribute_value {
    choice(
        seq("'", optional(alias(regexp(r"[^']+"), attribute_value)), "'"),
        seq("\"", optional(alias(regexp(r#"[^"]+"#), attribute_value)), "\""),
    )
}

rule text { regexp(r"[^<>&\s]([^<>&]*[^<>&\s])?") }
